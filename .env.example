# Copy to .env.

# Language of the HUD, the console logs and the Director's explanations: es (default) | en
LANGUAGE=es

# Without a valid key the AI Director uses its local rules.
ANTHROPIC_API_KEY=
# Optional: "rules" forces the local rules even with a key.
NEMESIS_DIRECTOR=claude
# Optional: Claude model used by the director.
NEMESIS_DIRECTOR_MODEL=claude-opus-5-5

# Optional: trace every director decision (LangGraph run) in LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=nemesis-protocol
